const {
  constructor(props) {
    super(props);
    this.state = {
      dataOuter: [],
      dataInner: [],
      loading: true,
    };
  }

  updateGraph = (item) => {
        const { dataInner, dataOuter } = this.state;
        if (item.electric_or_gas === "Electricity") {
          dataInner.push({ name: item.year, value: item.total_annual_consume });
        } else if (item.electric_or_gas === "Gas") {
          dataOuter.push({ name: item.year, value: item.total_annual_consume });
        } else {
          console.error("Invalid electric_or_gas value:", item.electric_or_gas);
        }
        this.setState({ dataInner, dataOuter, loading: false });
      };

  componentDidMount() {
    const { energyUsagePercentage, setEnergyUsagePercentage} = useContext(NavbarContext);
    console.log("This is the current energyUsagePercentage:", energyUsagePercentage);
    fetchData("2")
    .then((response) => {
      const { data } = response;
      data.forEach((item) => this.updateGraph(item));
    })
    .catch((error) => {
      console.error("Error fetching data:")
      this.setState({ loading: false });
    });
  }

  render() {
    const { dataOuter, dataInner, loading } = this.state;
    const { showElectric, showGas } = this.props;

    if (loading) {
      return <div>Loading...</div>;
    }
    return (
      <div style={{ 
        width: "100%",
        minHeight: "400px",
        display: "flex",
        justifyContent: "center",
        alignItems: "center", padding: "20px",
        boxSizing: "border-box" 
        }}>
        <ResponsiveContainer width="100%" height={400}>
          <PieChart>
            {showElectric && <Pie 
              data={this.state.dataInner} 
              dataKey="value" 
              cx="50%" 
              cy="50%" 
              innerRadius={90} 
              outerRadius={110} 
              label={renderOuterLabel} 
              labelLine
              >
              {this.state.dataInner.map((entry, index) => (
                  <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                ))}
            </Pie>}

            {showGas && <Pie 
              data={this.state.dataOuter} 
              dataKey="value" 
              cx="50%" 
              cy="50%" 
              outerRadius={80} 
              label={renderInnerLabel} 
              labelLine={false} 
            //   nameKey={"yearKeys"}
            >
              {this.state.dataOuter.map((entry, index) => (
                  <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                ))}
            </Pie>}

                {/* <Legend verticalAlign="bottom" height={36} /> */}
                <Legend 
  verticalAlign="bottom" 
  height={36} 
  payload={this.state.dataOuter.map((entry, index) => ({
    value: `${entry.name}`, // Include both name and value in the legend
    type: "circle", // Legend marker type
    color: COLORS[index % COLORS.length], // Dynamically assign colors
  }))}
/>
          </PieChart>
        </ResponsiveContainer>
      </div>
    );
  }
}
